        "import altair as alt\n",
        "import pandas as pd\n",
        "\n",
        "# Aggregate average checkouts by month and material type\n",
        "source = seattle_df.groupby(\n",
        "    [\"CheckoutMonth\", \"MaterialType\"]\n",
