      "source": [
        "import altair as alt\n",
        "import pandas as pd\n",
        "\n",
        "df = seattle_df.copy()\n",
        "df[\"CheckoutMonth\"] = pd.to_numeric(df[\"CheckoutMonth\"], errors=\"coerce\")\n",
        "df[\"Checkouts\"] = pd.to_numeric(df[\"Checkouts\"], errors=\"coerce\")\n",
        "df = df.dropna(subset=[\"CheckoutMonth\", \"Checkouts\"])\n",
        "df[\"CheckoutMonth\"] = df[\"CheckoutMonth\"].astype(int)\n",
        "\n",
        "source_month = (\n",
        "    df.groupby(\"CheckoutMonth\", as_index=False)[\"Checkouts\"]\n",
        "      .sum()\n",
        "      .rename(columns={\"CheckoutMonth\":\"month\", \"Checkouts\":\"total_checkouts\"})\n",
        ")\n",
        "\n",
        "month_select = alt.selection_point(fields=[\"month\"], on=\"click\", empty=\"all\")\n",
        "\n",
        "polar_chart = alt.Chart(source_month).mark_arc(innerRadius=50, stroke=\"white\").encode(\n",
        "    theta=alt.Theta(\"total_checkouts:Q\"),\n",
        "    color=alt.Color(\"month:O\", sort=list(range(1,13))),\n",
        "    opacity=alt.condition(month_select, alt.value(1), alt.value(0.25)),\n",
        "    tooltip=[\n",
        "        alt.Tooltip(\"month:O\", title=\"Month\"),\n",
        "        alt.Tooltip(\"total_checkouts:Q\", title=\"Total Checkouts\", format=\",\")\n",
        "    ]\n",
        ").add_params(\n",
        "    month_select\n",
        ").properties(\n",
        "    width=320, height=320,\n",
        "    title=\"Total Checkouts by Month (Click a slice)\"\n",
        ")\n",
        "\n",
        "polar_chart"
