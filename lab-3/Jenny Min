        "        \"CheckoutMonth:O\",\n",
        "        alt.Tooltip(\"Checkouts:Q\", title=\"Average Checkouts\", format=\".2f\")\n",
        "    ]\n",
        ").transform_window(\n",
        "    rank=\"rank()\",\n",
        "    sort=[alt.SortField(\"Checkouts\", order=\"descending\")],\n",
        "    groupby=[\"CheckoutMonth\"]\n",
        ").properties(\n",
        "    title=\"Bump Chart of Average Checkouts by Material Type Across Months\",\n",
        "    width=600,\n",
        "    height=250\n",
