      "cell_type": "code",
      "source": [
        "import altair as alt\n",
        "import pandas as pd\n",
        "\n",
        "# Aggregate: average checkouts by month and material type\n",
        "source = (\n",
        "    seattle_df.groupby([\"CheckoutMonth\", \"MaterialType\"])[\"Checkouts\"]\n",
        "    .mean()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "hover = alt.selection_point(\n",
        "    fields=[\"MaterialType\"],\n",
        "    on=\"mouseover\",\n",
        "    empty=\"all\"\n",
        ")\n",
        "\n",
        "chart = (\n",
        "    alt.Chart(source)\n",
        "    .transform_window(\n",
        "        rank=\"rank()\",\n",
        "        sort=[alt.SortField(\"Checkouts\", order=\"descending\")],\n",
        "        groupby=[\"CheckoutMonth\"]\n",
        "    )\n",
        "    .mark_line(point=True)\n",
        "    .encode(\n",
        "        x=alt.X(\"CheckoutMonth:O\", title=\"Month\"),\n",
        "        y=alt.Y(\"rank:O\", title=\"Rank (1 = highest avg checkouts)\"),\n",
        "        color=alt.Color(\"MaterialType:N\", title=\"Material Type\"),\n",
        "        opacity=alt.condition(hover, alt.value(1), alt.value(0.15)),\n",
        "        tooltip=[\n",
        "            alt.Tooltip(\"MaterialType:N\"),\n",
        "            alt.Tooltip(\"CheckoutMonth:O\"),\n",
        "            alt.Tooltip(\"Checkouts:Q\", title=\"Avg Checkouts\", format=\".2f\"),\n",
        "            alt.Tooltip(\"rank:O\", title=\"Rank\"),\n",
        "        ],\n",
        "    )\n",
        "    .add_params(hover)\n",
        "    .properties(width=650, height=280, title=\"Bump Chart: Material Type Rank by Avg Checkouts (Hover to highlight)\")\n",
        ")\n",
        "\n",
        "chart"
      ],
